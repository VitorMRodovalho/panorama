{
  "name": "panorama",
  "private": true,
  "version": "0.0.0",
  "description": "Unified open-source platform for IT asset and operational fleet management.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/VitorMRodovalho/panorama"
  },
  "homepage": "https://panorama.vitormr.dev",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "i18n:jsx-gate": "tsx scripts/i18n-jsx-gate.ts",
    "license:check": "tsx scripts/license-check.ts",
    "notices:generate": "tsx scripts/third-party-notices.ts",
    "migrations:check": "tsx scripts/check-migration-conventions.ts",
    "check:no-enterprise-imports": "tsx scripts/no-enterprise-imports.ts",
    "rls:allowlist-check": "tsx scripts/check-runAsSuperAdmin-allowlist.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "husky": "^9.1.7",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "vitepress": "^1.5.0",
    "vue": "^3.5.44",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": ">=7.29.6",
      "body-parser": ">=2.4.0 <3",
      "brace-expansion@1": ">=1.1.18 <2",
      "brace-expansion@2": ">=2.1.4 <3",
      "brace-expansion@5": ">=5.0.7 <6",
      "browserslist": ">=4.28.7 <5",
      "deepmerge-ts": ">=8.0.0 <9",
      "esbuild": ">=0.28.1",
      "fast-copy": ">=3.1.0 <4",
      "fast-uri": ">=3.1.9 <4",
      "file-type": ">=21.3.2",
      "form-data": ">=4.0.6",
      "js-yaml@4": ">=4.3.2 <5",
      "multer": ">=2.5.0 <3",
      "nanoid@>=5": ">=5.1.16 <6",
      "next": ">=16.4.2 <17",
      "nodemailer": ">=10.3.1 <11",
      "postcss": ">=8.5.23 <9",
      "proxy-addr": ">=2.0.8 <3",
      "qs": ">=6.16.1 <7",
      "sharp": ">=0.35.5 <0.36",
      "source-map-js": ">=1.2.2 <2",
      "vite": ">=7.3.7 <8",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0"
    }
  }
}
